{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:video-editor:flatpak-release-sources:v1",
  "x-license": "MPL-2.0",
  "title": "Video Editor Flatpak release source lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["license", "schemaVersion", "releaseBlocking", "reason", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "license": { "const": "MPL-2.0" },
    "schemaVersion": { "const": 1 },
    "releaseBlocking": { "type": "boolean" },
    "reason": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "archiveUrl", "sha256", "requiredResolution"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["release-blocking", "pinned"] },
          "archiveUrl": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^https://" }
            ]
          },
          "sha256": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            ]
          },
          "requiredResolution": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
