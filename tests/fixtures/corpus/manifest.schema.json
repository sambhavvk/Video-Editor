{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:video-editor:test-corpus-manifest:v1",
  "x-license": "MPL-2.0",
  "title": "Video Editor representative media corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "license",
    "status",
    "minimumAssetCount",
    "requiredCategories",
    "assets"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "license": { "const": "MPL-2.0" },
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["scaffold", "complete"] },
    "minimumAssetCount": { "type": "integer", "minimum": 200 },
    "requiredCategories": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "bytes",
        "sha256",
        "categories",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "path": {
          "type": "string",
          "pattern": "^files/[A-Za-z0-9._/-]+$"
        },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "container": { "type": "string" },
            "videoCodec": { "type": ["string", "null"] },
            "audioCodec": { "type": ["string", "null"] },
            "durationNumerator": { "type": "integer", "minimum": 0 },
            "durationDenominator": { "type": "integer", "minimum": 1 }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "license", "description"],
          "properties": {
            "kind": { "enum": ["generated", "redistributable", "internal"] },
            "license": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "sourceUrl": {
              "type": "string",
              "pattern": "^https://"
            },
            "generationRecipe": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
